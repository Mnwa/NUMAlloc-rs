# Op kind bytes (first byte of each op; see tests/common/mod.rs Decoder::op)
op_alloc="\x00"
op_alloc_zeroed="\x05"
op_free="\x06"
op_realloc="\x09"
op_replace="\x0b"
op_fill_empty="\x0c"
op_free_all="\x0d"
op_churn="\x0e"
op_touch="\x0f"
op_check_all="\x10"
op_validate="\x11"
op_huge="\x12"
op_realloc_edge="\x13"
op_transfer="\x14"
# Size encodings: mode 0 = boundary table lookup, mode 3 = power of two
size_table_first="\x00\x00"
size_table_mid="\x00\x40"
size_pow2_4k="\xc0\x0c"
size_pow2_256k="\xc0\x12"
size_pow2_256k_plus1="\xc1\x12"
size_pow2_4m="\xc0\x16"
# Alignment bytes
align_1="\x00"
align_8="\x03"
align_4096="\x8c"
align_256k="\x92"
align_4m="\x96"
